{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "票据台",
  "mainBinaryName": "invoice-desk",
  "version": "0.1.0",
  "identifier": "com.invoicedesk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run check",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "票据台", "width": 1440, "height": 920, "minWidth": 920, "minHeight": 600, "dragDropEnabled": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "nsis": { "languages": ["SimpChinese"], "displayLanguageSelector": false, "installMode": "currentUser" } }
  }
}
