#!/bin/sh
case "$2" in
  https://github.com/Sunnymark7/invoice-desk.git|git@github.com:Sunnymark7/invoice-desk.git) ;;
  *) echo "Push blocked: only the authorized invoice-desk repository is allowed." >&2; exit 1 ;;
esac
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" != "refs/heads/main" ]; then
    echo "Push blocked: only main is authorized for Pages deployment." >&2
    exit 1
  fi
done
